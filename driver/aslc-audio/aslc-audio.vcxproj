<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" ToolsVersion="Current" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>

  <PropertyGroup Label="Globals">
    <ProjectGuid>{A51C0A11-0000-4000-8000-000000000001}</ProjectGuid>
    <RootNamespace>aslc_audio</RootNamespace>
    <WindowsTargetPlatformVersion>10.0.26100.0</WindowsTargetPlatformVersion>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />

  <PropertyGroup Label="Configuration">
    <ConfigurationType>Driver</ConfigurationType>
    <DriverType>KMDF</DriverType>
    <PlatformToolset>WindowsKernelModeDriver10.0</PlatformToolset>
    <Driver_SpectreMitigation>false</Driver_SpectreMitigation>
    <SignMode>Off</SignMode>
    <EnableSigningAfterBuild>false</EnableSigningAfterBuild>
    <SkipPackageVerification>true</SkipPackageVerification>
    <UseDebugLibraries Condition="'$(Configuration)'=='Debug'">true</UseDebugLibraries>
    <UseDebugLibraries Condition="'$(Configuration)'=='Release'">false</UseDebugLibraries>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />

  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalIncludeDirectories>$(ProjectDir)src;$(ProjectDir)..\third_party\sysvad;$(ProjectDir)..\third_party\sysvad\EndpointsCommon;$(IntDir);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PreprocessorDefinitions>_WIN32;UNICODE;_UNICODE;PC_IMPLEMENTATION;_USE_WAVERT_;_USE_IPortClsRuntimePower;_NEW_DELETE_OPERATORS_;DEBUG_LEVEL=DEBUGLVL_TERSE;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <WarningLevel>Level3</WarningLevel>
      <TreatWarningAsError>false</TreatWarningAsError>
      <AdditionalOptions>/WX- /wd4296 %(AdditionalOptions)</AdditionalOptions>
      <LanguageStandard>stdcpp17</LanguageStandard>
    </ClCompile>
    <Link>
      <AdditionalDependencies>%(AdditionalDependencies);$(DDK_LIB_PATH)\portcls.lib;$(DDK_LIB_PATH)\stdunk.lib;$(DDK_LIB_PATH)\libcntpr.lib</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>

  <ItemGroup>
    <!-- SysVAD-derived core (see third_party/sysvad/LICENSE-windows-driver-samples.txt) -->
    <ClCompile Include="..\third_party\sysvad\adapter.cpp" />
    <ClCompile Include="..\third_party\sysvad\basetopo.cpp" />
    <ClCompile Include="..\third_party\sysvad\common.cpp" />
    <ClCompile Include="..\third_party\sysvad\hw.cpp" />
    <ClCompile Include="..\third_party\sysvad\kshelper.cpp" />
    <ClCompile Include="..\third_party\sysvad\savedata.cpp" />
    <ClCompile Include="..\third_party\sysvad\ToneGenerator.cpp" />
    <ClCompile Include="..\third_party\sysvad\EndpointsCommon\minwavert.cpp" />
    <ClCompile Include="..\third_party\sysvad\EndpointsCommon\minwavertstream.cpp" />
    <ClCompile Include="..\third_party\sysvad\EndpointsCommon\mintopo.cpp" />
    <ClCompile Include="..\third_party\sysvad\EndpointsCommon\speakertopo.cpp" />
    <ClCompile Include="..\third_party\sysvad\EndpointsCommon\AudioModuleHelper.cpp" />
    <ClCompile Include="src\aslc-engine-nodes.cpp" />
    <ClCompile Include="src\aslc_capture.cpp" />
    <ClCompile Include="..\third_party\sysvad\EndpointsCommon\NewDelete.cpp" />
  </ItemGroup>

  <ItemGroup>
    <Inf Include="inf\aslc-audio.inx" />
  </ItemGroup>

  <ItemGroup>
    <FilesToPackage Include="$(TargetPath)" />
    <FilesToPackage Include="@(Inf->'%(CopyOutput)')" Condition="'@(Inf)'!=''" />
  </ItemGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
