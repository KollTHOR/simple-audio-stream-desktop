; ASLC virtual audio driver — installation INF.
;
; Original ASLC code. Derived from Microsoft's SysVAD sample
; (ComponentizedAudioSample.inx); see
; driver/third_party/sysvad/LICENSE-windows-driver-samples.txt.
; Trimmed to a single render (playback) endpoint exposed as "ASLC".

[Version]
Signature   = "$Windows NT$"
Class       = MEDIA
Provider    = %ProviderName%
ClassGUID   = {4d36e96c-e325-11ce-bfc1-08002be10318}
DriverVer   = 10/06/2026, 0.1.0.0
CatalogFile = aslc-audio.cat
PnpLockDown = 1

[SourceDisksNames]
222 = "ASLC Driver Disk",,,

[SourceDisksFiles]
aslc-audio.sys = 222

[SignatureAttributes]
aslc-audio.sys = SignatureAttributes.DRM

[SignatureAttributes.DRM]
DRMLevel = 1300

[Manufacturer]
%MfgName% = ASLC,NT$ARCH$

[ASLC.NT$ARCH$]
%ASLC.DeviceDesc% = ASLC_Device, Root\ASLC

[DestinationDirs]
ASLC_Device.CopyList = 13 ; DriverStore

;======================================================
; Device
;======================================================
[ASLC_Device.CopyList]
aslc-audio.sys

[ASLC_Device.AddReg]
HKR,,AssociatedFilters,,"wdmaud,swmidi,redbook"
HKR,,Driver,,aslc-audio.sys

HKR,PowerSettings,ConservationIdleTime,3,3,0,0,0
HKR,PowerSettings,PerformanceIdleTime,3,3,0,0,0
HKR,PowerSettings,IdlePowerState,3,3,0,0,0

HKR,Drivers,SubClasses,,"wave,midi,mixer"

HKR,Drivers\wave\wdmaud.drv,Driver,,wdmaud.drv
HKR,Drivers\midi\wdmaud.drv,Driver,,wdmaud.drv
HKR,Drivers\mixer\wdmaud.drv,Driver,,wdmaud.drv

HKR,Drivers\wave\wdmaud.drv,Description,,%ASLC.DeviceDesc%
HKR,Drivers\midi\wdmaud.drv,Description,,%ASLC.DeviceDesc%
HKR,Drivers\mixer\wdmaud.drv,Description,,%ASLC.DeviceDesc%

;======================================================
; Render interfaces: ASLC (playback)
;======================================================
[ASLC.I.WaveASLC]
AddReg = ASLC.I.WaveASLC.AddReg

[ASLC.I.WaveASLC.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%ASLC.WaveASLC.szPname%

[ASLC.I.TopologyASLC]
AddReg = ASLC.I.TopologyASLC.AddReg

[ASLC.I.TopologyASLC.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%ASLC.TopologyASLC.szPname%

HKR,EP\0,%PKEY_AudioEndpoint_Association%,,%KSNODETYPE_ANY%
; Opt in to pull-mode (event-driven) rendering.
HKR,EP\0,%PKEY_AudioEndpoint_Supports_EventDriven_Mode%,0x00010001,0x1

;======================================================
; Install sections
;======================================================
[ASLC_Device.NT]
Include = ks.inf,wdmaudio.inf
Needs   = KS.Registration,WDMAUDIO.Registration
CopyFiles = ASLC_Device.CopyList
AddReg = ASLC_Device.AddReg

[ASLC_Device.NT.Interfaces]
AddInterface = %KSCATEGORY_AUDIO%,    %KSNAME_WaveASLC%,     ASLC.I.WaveASLC
AddInterface = %KSCATEGORY_RENDER%,   %KSNAME_WaveASLC%,     ASLC.I.WaveASLC
AddInterface = %KSCATEGORY_REALTIME%, %KSNAME_WaveASLC%,     ASLC.I.WaveASLC
AddInterface = %KSCATEGORY_AUDIO%,    %KSNAME_TopologyASLC%, ASLC.I.TopologyASLC
AddInterface = %KSCATEGORY_TOPOLOGY%, %KSNAME_TopologyASLC%, ASLC.I.TopologyASLC

[ASLC_Device.NT.Services]
AddService = aslc_audio,0x00000002,ASLC_Service_Inst

[ASLC_Service_Inst]
DisplayName    = %ASLC.SvcDesc%
ServiceType    = 1                  ; kernel driver
StartType      = 3                  ; demand start
ErrorControl   = 1                  ; normal
ServiceBinary  = %13%\aslc-audio.sys

[ASLC_Device.NT.HW]
AddReg = ASLC_Device.HW.AddReg

[ASLC_Device.HW.AddReg]
; FILE_DEVICE_SOUND
HKR,,DeviceType,0x10001,0x0000001D
; SDDL_DEVOBJ_SYS_ALL_ADM_RWX_WORLD_RWX_RES_RWX
HKR,,Security,,"D:P(A;;GA;;;SY)(A;;GRGWGX;;;BA)(A;;GRGWGX;;;WD)(A;;GRGWGX;;;RC)"

[ASLC_Device.NT.Wdf]
KmdfService = aslc_audio, ASLC_WdfSect

[ASLC_WdfSect]
KmdfLibraryVersion = $KMDFVERSION$

;======================================================
; Strings
;======================================================
[Strings]

; Non-localizable
KSNAME_WaveASLC     = "WaveASLC"
KSNAME_TopologyASLC = "TopologyASLC"

Proxy.CLSID             = "{17CCA71B-ECD7-11D0-B908-00A0C9223196}"
KSCATEGORY_AUDIO        = "{6994AD04-93EF-11D0-A3CC-00A0C9223196}"
KSCATEGORY_RENDER       = "{65E8773E-8F56-11D0-A3B9-00A0C9223196}"
KSCATEGORY_REALTIME     = "{EB115FFC-10C8-4964-831D-6DCB02E6F23F}"
KSCATEGORY_TOPOLOGY     = "{DDA54A40-1E4C-11D1-A050-405705C10000}"
KSNODETYPE_ANY          = "{00000000-0000-0000-0000-000000000000}"

PKEY_AudioEndpoint_Association               = "{1DA5D803-D492-4EDD-8C23-E0C0FFEE7F0E},2"
PKEY_AudioEndpoint_Supports_EventDriven_Mode = "{1DA5D803-D492-4EDD-8C23-E0C0FFEE7F0E},7"

; Localizable
ProviderName = "ASLC"
MfgName      = "ASLC"

ASLC.DeviceDesc              = "ASLC"
ASLC.SvcDesc                 = "ASLC Virtual Audio Driver"
ASLC.WaveASLC.szPname        = "ASLC"
ASLC.TopologyASLC.szPname    = "ASLC"
