; ============================================================================
; ASLC Node WinUSB device package — installs Microsoft's in-box WinUSB driver
; onto the USB interfaces the ASLC desktop node talks to (no vendor binaries).
;
; Fully generic: matches *class/compatible IDs only*, never per-device VID/PIDs.
;   [PreHandshake]   the generic Android MTP function (USB\MS_COMP_MTP). Binding
;                    WinUSB to it lets the host send the AOA handshake without
;                    USB debugging. While installed it replaces the inbox WPD/MTP
;                    driver for MTP devices ON THIS PC ONLY; the app's "Restore
;                    file transfer (MTP)" action removes the package to bring
;                    normal MTP back.
;   [Accessory]      the standardized Android AOA accessory interfaces
;                    (18d1:2D00/2D01/2D04/2D05, data iface = MI_00 when the
;                    accessory composite also carries audio/adb functions).
;
; App side opens the device through the fixed DeviceInterfaceGUID below.
; ============================================================================

[Version]
Signature   = "$WINDOWS NT$"
Class       = USB
ClassGuid   = {36fc9e60-c465-11cf-8056-444553540000}
Provider    = %ProviderName%
CatalogFile = aslc_aoa.cat
DriverVer   = 10/03/2026,1.0.0.0
PnpLockdown = 1

[Manufacturer]
%ProviderName% = Standard, NTamd64.10.0...17763

[Standard.NTamd64.10.0...17763]
; ---- generic pre-handshake door (no per-device hardware IDs) ----
; Bind WinUSB to any Android phone's MTP function so the host can send the AOA handshake without
; USB debugging and without per-device entries. While installed this replaces the inbox WPD/MTP
; driver for MTP devices on THIS PC only. The app's "Restore file transfer (MTP)" action removes
; the package, which returns the phone to normal MTP.
%PreHandshake.DeviceDesc% = ASLC_PreHandshake_Install, USB\MS_COMP_MTP

; ---- AOA accessory data interface (standard AOA protocol IDs, not device-specific) ----
; IMPORTANT: match the MI_00 CHILD of composites (2D01/2D04/2D05 carry adb/audio
; siblings). Binding the bare PARENT would take the whole composite away from
; usbccgp and silently kill adb/audio sibling functions - do NOT add bare parent
; IDs for composite configurations. 2D00 (accessory only, single function) is
; bare-legit.
%Accessory.DeviceDesc% = ASLC_Accessory_Install, USB\VID_18D1&PID_2D00
%Accessory.DeviceDesc% = ASLC_Accessory_Install, USB\VID_18D1&PID_2D01&MI_00
%Accessory.DeviceDesc% = ASLC_Accessory_Install, USB\VID_18D1&PID_2D04&MI_00
%Accessory.DeviceDesc% = ASLC_Accessory_Install, USB\VID_18D1&PID_2D05&MI_00

; ----------------------------------------------------------------------------

[ASLC_PreHandshake_Install]
Include = winusb.inf
Needs   = WINUSB.NT

; DeviceInterfaceGUIDs must be registered for WinUSB clients (nusb) to open the interface. It
; belongs in the device's .HW section (the hardware key); the .Services AddReg below was NOT
; applied on real installs, which left the door unopenable.
[ASLC_PreHandshake_Install.HW]
AddReg  = ASLC_Guid.AddReg

[ASLC_PreHandshake_Install.Services]
Include = winusb.inf
AddReg  = ASLC_Guid.AddReg
Needs   = WINUSB.NT.Services

[ASLC_Accessory_Install]
Include = winusb.inf
Needs   = WINUSB.NT

[ASLC_Accessory_Install.HW]
AddReg  = ASLC_Guid.AddReg

[ASLC_Accessory_Install.Services]
Include = winusb.inf
AddReg  = ASLC_Guid.AddReg
Needs   = WINUSB.NT.Services

; The stable GUID the desktop app enumerates by. Never change it.
[ASLC_Guid.AddReg]
HKR,,DeviceInterfaceGUIDs,0x10000,"{4a2f0b1c-7f5d-4e22-9b34-0b6c2f1d5a77}"

[Strings]
ProviderName            = "ASLC Node (self-signed dev package)"
PreHandshake.DeviceDesc = "ASLC Phone USB Door"
Accessory.DeviceDesc    = "ASLC AOA Accessory Data Interface"
